{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vitest/globals"],
    "lib": ["ES2022", "DOM"],
    "baseUrl": ".",
    "paths": {
      "@engine-under-test": ["./reference/index.ts"]
    }
  },
  "include": ["reference/**/*.ts", "tests/**/*.ts", "vitest.config.ts"],
  "exclude": ["_work", "node_modules"]
}
