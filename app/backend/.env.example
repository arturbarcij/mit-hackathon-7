# Copy this file to .env in the same folder and fill in your keys.
# .env is git-ignored. Never commit it, never paste keys in chat.
# Server-side only: do NOT prefix any of these with VITE_ (that would ship them to the browser).

# Research (BrightData)
BRIGHTDATA_API_KEY=
BRIGHTDATA_SERP_ZONE=
BRIGHTDATA_UNLOCKER_ZONE=

# Voice (ElevenLabs), used only by backend/scripts/render_audio.py at build time
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_SW=
ELEVENLABS_VOICE_ID_EN=

# Lovable public API (optional; the MCP connection already works without it)
LOVABLE_API_KEY=

# Claude (agents, reviews)
ANTHROPIC_API_KEY=

# Gemini Pro (independent reviewer)
GEMINI_API_KEY=

# Hugging Face (only if a model download needs a token; MMS-TTS and NLLB are public)
HF_TOKEN=
